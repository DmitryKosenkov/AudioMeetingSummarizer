server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 500M;

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
